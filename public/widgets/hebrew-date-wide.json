{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "rtl": true,
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "width": "auto",
          "items": [
            {
              "type": "TextBlock",
              "text": "KRONOJ",
              "size": "Small",
              "color": "Accent",
              "spacing": "None"
            }
          ],
          "verticalContentAlignment": "Center"
        },
        {
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${hebrewDate}",
              "size": "Large",
              "weight": "Bolder",
              "color": "Light",
              "horizontalAlignment": "Center",
              "wrap": true
            },
            {
              "type": "TextBlock",
              "text": "${location}",
              "size": "Small",
              "color": "Default",
              "horizontalAlignment": "Center",
              "wrap": true,
              "spacing": "Small"
            }
          ],
          "verticalContentAlignment": "Center"
        },
        {
          "width": "auto",
          "items": [
            {
              "type": "TextBlock",
              "text": "${gregorianDate}",
              "size": "Small",
              "color": "Default",
              "wrap": true
            }
          ],
          "verticalContentAlignment": "Center"
        }
      ]
    }
  ]
}
