{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "rtl": true,
  "body": [
    {
      "type": "TextBlock",
      "text": "KRONOJ",
      "size": "Small",
      "color": "Accent",
      "horizontalAlignment": "Center",
      "spacing": "None"
    },
    {
      "type": "TextBlock",
      "text": "${hebrewDate}",
      "size": "Large",
      "weight": "Bolder",
      "color": "Light",
      "horizontalAlignment": "Center",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "${location}",
      "size": "Small",
      "color": "Default",
      "horizontalAlignment": "Center",
      "wrap": true,
      "spacing": "Small"
    }
  ]
}
