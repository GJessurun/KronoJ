{
  "productName": "KronoJ",
  "version": "0.1.9",
  "identifier": "com.jessu.kronoj",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KronoJ",
        "width": 820,
        "height": 720,
        "minWidth": 560,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "headerImage": "icons/installer-nsis-header.bmp",
        "sidebarImage": "icons/installer-nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "upgradeCode": "527194e6-1393-55d2-8b35-e58f929f44ad",
        "bannerPath": "icons/installer-wix-banner.bmp",
        "dialogImagePath": "icons/installer-wix-dialog.bmp"
      }
    }
  }
}
